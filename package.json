{
  "name": "ai-ssh-pro",
  "version": "0.1.0",
  "description": "类 Xshell 的多会话 SSH 客户端，集成 AI 对话（方案 B：Electron + TypeScript）",
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "dist": "npm run build && electron-builder",
    "icons": "node scripts/build-icon.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "mcp:inventory": "node scripts/mcp-inventory-server.mjs",
    "smoke": "npx tsx scripts/smoke-test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "electron-store": "^10.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "ssh2": "^1.16.0",
    "uuid": "^11.0.5",
    "zmodem.js": "^0.1.10",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ssh2": "^1.15.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "sharp": "^0.34.5",
    "to-ico": "^1.1.5",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  },
  "optionalDependencies": {
    "node-pty": "^1.0.0"
  },
  "build": {
    "appId": "com.aisspro.app",
    "productName": "AI-SSH-Pro",
    "npmRebuild": false,
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*"
    ],
    "icon": "build/icon.ico",
    "extraResources": [
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "dir"
      ],
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "guoshuaipeng",
        "repo": "ai-ssh-pro"
      }
    ]
  }
}
