      "policy": {
        "settings": {
          "aiPolicy": "auto"
        },
        "protection": {
          "level": "production"
        }
      },
      "expectHint": null
    },
    {
      "id": "H01-banner-normal-hides",
      "level": "normal",
      "paused": false,
      "policy": {
        "settings": {
          "aiPolicy": "auto"
        }
      },
      "expectHint": null
