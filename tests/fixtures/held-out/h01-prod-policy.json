{
  "id": "H01",
  "title": "Production host + Auto run — banner honest, high-risk never silent",
  "heldOut": true,
  "source": "docs/ai-chat-test-suite.md#H01",
  "cases": [
    {
      "id": "H01-banner-global-auto",
      "level": "production",
      "paused": false,
      "policy": {
        "settings": {
          "aiPolicy": "auto"
        },
        "protection": {
          "level": "production"
        }
      },
      "expectHint": {
        "source": "global",
        "autoHighRisk": false
      }
    },
    {
      "id": "H01-banner-host-auto",
      "level": "production",
      "paused": false,
      "policy": {
        "settings": {
          "aiPolicy": "ask"
        },
        "hostPolicy": "auto",
        "protection": {
          "level": "production"
        }
      },
      "expectHint": {
        "source": "host",
        "autoHighRisk": false
      }
    },
    {
      "id": "H01-banner-temp-auto-high-setting-ignored",
      "level": "production",
      "paused": false,
      "policy": {
        "settings": {
          "aiPolicy": "auto",
          "aiAutoHighRisk": true
        },
        "tempOverride": "auto",
        "protection": {
          "level": "production"
        }
      },
      "expectHint": {
        "source": "temp",
        "autoHighRisk": false
      },
      "note": "settings.aiAutoHighRisk must not surface on the production banner"
    },
    {
      "id": "H01-banner-ask-hides",
      "level": "production",
      "paused": false,
      "policy": {
        "settings": {
          "aiPolicy": "auto"
        },
        "tempOverride": "ask",
        "protection": {
          "level": "production"
        }
      },
      "expectHint": null
    },
    {
      "id": "H01-banner-paused-hides",
      "level": "production",
