    "production hosts still require high-risk confirmation",
    "中低风险可自动，高危仍需确认",
    "mid/low may auto; high-risk still confirms"
  ],
  "copyMustNotInclude": [
    "开启后对生产主机同样生效",
    "Applies to production hosts too; never on read-only hosts."
  ],
  "wiring": {
    "appMustInclude": [
      "const autoHint = prodAutoHint({",
      "data-testid=\"banner-ai-auto\""
    ],
    "panelMustInclude": [
      "data-testid=\"ai-prod-auto-banner\"",
      "protectionForUi === 'production'",
      "elevated && protectionForUi ==="
    ],
    "agentMustInclude": [
      "blockSilentHighRiskOnProd"
    ]
  }
