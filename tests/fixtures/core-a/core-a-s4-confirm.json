{
  "id": "S4",
  "title": "Low-risk command still requires confirm when autoApproveLowRisk is off",
  "industryBar": ["langgraph-human-in-the-loop", "confirm-before-run"],
  "hostProfile": {
    "hostId": "host-prod-web-01",
    "label": "prod-web-01"
  },
  "session": {
    "targetSessionId": "sess-s4-confirm",
    "historyKey": "host-prod-web-01"
  },
  "settings": {
    "autoApproveLowRisk": false,
    "useOpenClaw": true
  },
  "turns": [
    {
      "turnId": "S4-T1",
      "userMessage": "跑一下 uptime 看看负载。",
      "mockTerminal": {
        "initialRing": "",
        "afterWrite": {
          "uptime": " 14:31:02 up 10 days,  3:12,  1 user,  load average: 0.42, 0.38, 0.35\n"
        }
      },
      "userConfirm": {
        "policy": "assert-pending-then-approve",
        "assert": {
          "stepHasRequestId": true,
          "autoApproved": false,
          "sshWriteBeforeApprove": false
        }
      },
      "mockedPlannerSteps": [
        {
          "step": 1,
          "response": {
            "description": "建议执行只读 uptime。",
            "action": "command",
            "command": "uptime",
            "riskLevel": "low",
            "completed": false
          }
        },
        {
          "step": 2,
          "response": {
            "description": "读取 uptime 输出。",
            "action": "tool_call",
            "toolName": "get_terminal_snapshot",
            "toolInput": { "maxLines": 400, "fromCurrentCommand": true, "includeCommandLine": true },
            "riskLevel": "low",
            "completed": false
          }
        },
        {
          "step": 3,
          "response": {
            "description": "负载正常：load average 约 0.42 / 0.38 / 0.35，已运行约 10 days。",
            "action": "end",
            "completed": true,
            "riskLevel": "low"
          }
        }
      ],
      "expected": {
        "finalAction": "end",
        "descriptionMustContain": ["0.42", "load"],
        "confirmGate": {
          "required": true,
          "evenIfRiskLevelLow": true,
          "settingsAutoApproveLowRisk": false
        }
      }
    }
  ],
  "negativeCase": {
    "turnId": "S4-T1-deny",
    "userConfirm": { "policy": "deny" },
    "expected": {
      "ipc": ["cancelled", "done"],
      "sshWriteCount": 0,
      "noFurtherPlannerStepsAfterDeny": true
    }
  },
  "passCriteriaSummary": [
    "riskLevel=low still emits requestId when autoApproveLowRisk=false",
    "no SSH write before approve",
    "deny cancels cleanly"
  ]
}
