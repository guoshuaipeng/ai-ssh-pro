          "description": "第一次提议 echo S27_FAIL_CMD，等待确认。",
          "action": "command",
          "command": "echo S27_FAIL_CMD",
          "riskLevel": "low",
          "completed": false
        }
      },
      {
        "response": {
          "description": "失败后再次提议同一命令，等待新的确认。",
          "action": "command",
          "command": "echo S27_FAIL_CMD",
          "riskLevel": "low",
          "completed": false
        }
      },
      {
        "response": {
          "description": "拒绝后不应再写 echo S27_AFTER_DENY。",
          "action": "command",
          "command": "echo S27_AFTER_DENY",
          "riskLevel": "low",
          "completed": false
        }
      },
      {
        "response": {
          "description": "拒绝后不应把重试说成已经成功。",
          "action": "end",
          "completed": true,
          "riskLevel": "low"
        }
      }
    ],
    "expected": {
      "minPlannerSteps": 2,
