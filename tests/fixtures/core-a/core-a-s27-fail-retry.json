      "mustNotEmitCommands": ["echo S27_AFTER_DENY"],
      "commandFailure": {
        "command": "echo S27_FAIL_CMD",
        "evidence": ["S27_STDERR_EVIDENCE", "exit=1", "S27_TIMEOUT_STUB"],
        "writeCount": 1,
        "minDistinctRequestIds": 2,
        "endCitesEvidence": false
      },
      "hitl": {
        "minInterrupts": 2,
        "resume": "deny",
        "decisions": ["approve", "deny"],
        "released": true
      }
    }
  },
