{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI-SSH-Pro",
  "version": "0.7.0",
  "identifier": "com.aisspro.app",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist-tauri"
  },
  "app": {
    "windows": [
      {
        "title": "AI-SSH-Pro",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "label": "main",
        "decorations": false,
        "backgroundColor": "#161b22",
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/henry.w@example.net",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZENjFDN0QyQkI3N0M0NjAKUldSZ3hIZTcwc2RoYllDZ2N4Tk1uYUFyMmRjdUt6WWVQV2JhcW1wSVBhWUUvN2Jzak1qKytBRjIK",
      "endpoints": [
        "https://github.com/guoshuaipeng/ai-ssh-pro/releases/latest/download/latest.json",
        "https://guoshuaipeng.github.io/ai-ssh-pro/updater/{{target}}/{{arch}}/{{current_version}}.json"
      ]
    }
  }
}
